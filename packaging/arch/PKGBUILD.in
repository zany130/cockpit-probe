pkgname=cockpit-hardware-probe
pkgver=VERSION
pkgrel=1
pkgdesc='Cockpit UI around hw-probe'
arch=('x86_64')
url='https://linux-hardware.org/'
license=(LGPL-2.1-or-later)
source=("SOURCE")
sha256sums=('SKIP')

package() {
  depends=(cockpit)
  cd $pkgname
  make DESTDIR="$pkgdir" install PREFIX=/usr
}
